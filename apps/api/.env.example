
# Server
PORT=8080
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgres://lifygo:lifygo@localhost:5432/lifygo?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Auth — "local" (JWT, no external dependency) or "clerk"
AUTH_PROVIDER=local

# Required when AUTH_PROVIDER=local
JWT_SECRET=change-me-to-a-long-random-string

# Required when AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

ENCRYPTION_KEY=

MAX_JOBS_PER_USER=0
MAX_API_KEYS_PER_USER=0


RATE_LIMIT_PER_HOUR=10000

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=
SCHEDULER_ROLE_ARN=
SQS_QUEUE_ARN=